    title(['Frequency Domain Plot of Carrier #' num2str(i)]);
    xlabel('Frequency (Hz)');
    ylabel('Magnitude (dB)');
    xlim([-2e4, 2e4]);
    ylim([-110 -20])
    grid on;

    subplot(2, 1, 2);
    plot(timeVector, plotTime{i});
    title(['Time Domain Plot of Carrier #' num2str(i)]);
    xlabel('Time (s)');
    ylabel('Amplitude');
    grid on;

end 

