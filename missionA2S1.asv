% Frequency with which we search above for single-tone components
initial_f = 2000;

[cleaned_signal_t1, Cleaned_Signal_f1] = ...
    removetones(audioclean1_f, fA, initial_f, cutoffFreq1, fs);
[cleaned_signal_t2, Cleaned_Signal_f2] = ...
